# Скопируй в .env и заполни своими значениями
# cp .env.example .env

# Telegram бот (получить у @BotFather)
TG_BOT_TOKEN=

# Telegram chat_id для уведомлений оркестратора (получить у @userinfobot)
TG_CHAT_ID=

# Groq API (бесплатно: console.groq.com)
GROQ_KEY=

# Опционально — другие LLM для оркестратора
GEMINI_KEY=
MISTRAL_KEY=
CEREBRAS_KEY=
